// Prisma schema: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum VENDOR_CATEGORY {
  WEDDING_HALL
  STUDIO
  DRESS
  MAKEUP
  ETC
}

enum PROJECT_VENDOR_STATUS {
  CANDIDATE
  CONTRACTED
}

enum QUOTE_STATUS {
  DRAFT
  CONFIRMED
}

enum PAYMENT_LABEL {
  DEPOSIT
  MIDDLE
  FINAL
  ETC
}

model users {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  weddingProjects wedding_projects[]
}

model wedding_projects {
  id          String    @id @default(cuid())
  userId      String
  title       String
  weddingDate DateTime?
  region      String?
  guestCount  Int?
  createdAt   DateTime  @default(now())

  user             users               @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgetCategories budget_categories[]
  projectVendors   project_vendors[]
  contracts        contracts[]
  tasks            tasks[]
  documents        documents[]
}

model budget_categories {
  id            String @id @default(cuid())
  projectId     String
  name          String
  plannedAmount Int    @default(0)
  sortOrder     Int

  project wedding_projects @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
}

model vendors {
  id           String          @id @default(cuid())
  kakaoPlaceId String?         @unique
  name         String
  category     VENDOR_CATEGORY
  address      String?
  phone        String?

  projectVendors project_vendors[]
}

model project_vendors {
  id         String                @id @default(cuid())
  projectId  String
  vendorId   String
  memo       String?
  isFavorite Boolean               @default(false)
  status     PROJECT_VENDOR_STATUS @default(CANDIDATE)
  createdAt  DateTime              @default(now())

  project wedding_projects @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor  vendors          @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  quotes  quotes[]

  @@unique([projectId, vendorId])
}

model quotes {
  id              String       @id @default(cuid())
  projectVendorId String
  quoteDate       DateTime
  guestCount      Int
  validUntil      DateTime?
  notes           String?
  status          QUOTE_STATUS @default(DRAFT)
  createdAt       DateTime     @default(now())

  projectVendor project_vendors @relation(fields: [projectVendorId], references: [id], onDelete: Cascade)
  quoteItems    quote_items[]
  contract      contracts?
  documents     documents[]
}

model quote_items {
  id        String  @id @default(cuid())
  quoteId   String
  itemCode  String?
  rawName   String
  qty       Int     @default(1)
  unitPrice Int
  amount    Int
  required  Boolean @default(true)
  selected  Boolean @default(false)
  sortOrder Int

  quote quotes @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model contracts {
  id                 String   @id @default(cuid())
  quoteId            String   @unique
  projectId          String
  amountSnapshot     Int
  vendorNameSnapshot String
  signedDate         DateTime
  notes              String?

  // Restrict: contract snapshots are the financial source of truth; a quoted-and-signed
  // quote must not disappear and silently drop its contract. Delete contract first.
  quote    quotes           @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  project  wedding_projects @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payments payments[]
}

model payments {
  id         String        @id @default(cuid())
  contractId String
  label      PAYMENT_LABEL
  amount     Int
  dueDate    DateTime
  paidAt     DateTime?

  contract contracts @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model tasks {
  id        String    @id @default(cuid())
  projectId String
  title     String
  dueDate   DateTime?
  done      Boolean   @default(false)
  sortOrder Int

  project wedding_projects @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model documents {
  id          String   @id @default(cuid())
  projectId   String
  quoteId     String?
  fileName    String
  storagePath String
  mimeType    String
  sizeBytes   Int
  uploadedAt  DateTime @default(now())

  project wedding_projects @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // SetNull: the uploaded file record outlives its optional quote link.
  quote quotes? @relation(fields: [quoteId], references: [id], onDelete: SetNull)
}

model price_benchmarks {
  id           String   @id @default(cuid())
  region       String
  category     String
  itemCode     String?
  avgPrice     Int
  sampleSize   Int
  sourcePeriod String
  sourceType   String   @default("참가격")
  createdAt    DateTime @default(now())

  @@unique([region, category, itemCode, sourcePeriod])
}

// 한국소비자원 참가격 포털 '중요정보 공개(예식장)' 게시물 단위 공개 자료.
// boardSeq = 게시물 식별자(재수집 멱등 키), xlsx 원문은 파싱해 자식 테이블로 정규화해 보관한다.
model wedding_hall_disclosures {
  id          String    @id @default(cuid())
  boardSeq    Int       @unique
  region      String
  venueName   String
  address     String?
  phone       String?
  fileRgtnSeq Int?
  fileName    String?
  disclosedAt DateTime?
  scrapedAt   DateTime  @default(now())

  priceItems     wedding_hall_price_items[]
  refundPolicies wedding_hall_refund_policies[]

  @@index([region])
}

model wedding_hall_price_items {
  id           String  @id @default(cuid())
  disclosureId String
  hallName     String
  itemGroup    String?
  itemName     String
  rawValue     String?
  priceMin     Int?
  priceMax     Int?
  sortOrder    Int

  disclosure wedding_hall_disclosures @relation(fields: [disclosureId], references: [id], onDelete: Cascade)

  @@index([disclosureId])
}

model wedding_hall_refund_policies {
  id           String @id @default(cuid())
  disclosureId String
  periodText   String
  ruleText     String
  sortOrder    Int

  disclosure wedding_hall_disclosures @relation(fields: [disclosureId], references: [id], onDelete: Cascade)

  @@index([disclosureId])
}
