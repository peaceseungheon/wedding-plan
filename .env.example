# MySQL (docker compose, npm run db:up)
# 호스트 3306이 네이티브 MySQL로 점유된 머신이라 compose가 127.0.0.1:3307로 노출한다.
DATABASE_URL="mysql://root:<password>@localhost:3307/wedding"

# 세션 서명용 시크릿 (openssl rand -base64 32 로 생성)
SESSION_SECRET="<generate-a-random-secret>"

# Kakao 로컬 검색 API 키 (https://developers.kakao.com)
KAKAO_API_KEY=

# Kakao 지도 Web SDK용 JavaScript 키 (선택. 예식장 위치 지도. 개발자콘솔에서 Web 플랫폼 추가 및 사이트 도메인 등록 필요)
NEXT_PUBLIC_KAKAO_JS_KEY=

# 업로드 문서 저장 디렉터리
UPLOAD_DIR=storage/uploads
